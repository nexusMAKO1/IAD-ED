# =============================================================================
# IAD & SmartQueue AI — Environment Variables Template
# Express Display
#
# INSTRUCTIONS:
#   1. Copier ce fichier : cp .env.example .env
#   2. Remplir TOUTES les valeurs (surtout les secrets marqués CHANGE_ME)
#   3. Ne JAMAIS committer le fichier .env sur Git
# =============================================================================

# ---------------------------------------------------------------------------
## Application
# ---------------------------------------------------------------------------
# Environnement d'exécution : development | staging | production
NODE_ENV=development

# Port exposé par le backend NestJS
API_PORT=3000

# Port exposé par le frontend Vite
FRONTEND_PORT=5173

# ---------------------------------------------------------------------------
## Database — PostgreSQL 16 + TimescaleDB
# ---------------------------------------------------------------------------
# Nom de la base de données principale
POSTGRES_DB=iad_db

# Utilisateur PostgreSQL (ne pas utiliser "root" ou "postgres" en prod)
POSTGRES_USER=iad_user

# Mot de passe PostgreSQL — CHANGE_ME en production (min 32 chars recommandé)
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Port exposé par PostgreSQL sur l'hôte
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
## Redis — Cache & Sessions
# ---------------------------------------------------------------------------
# Hostname Redis (interne Docker)
REDIS_HOST=redis

# Port Redis
REDIS_PORT=6379

# Mot de passe Redis — CHANGE_ME en production
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------------------------------------------------------------------------
## MQTT — Mosquitto Broker
# ---------------------------------------------------------------------------
# Hostname du broker MQTT (interne Docker)
MQTT_HOST=mosquitto

# Port MQTT standard
MQTT_PORT=1883

# Port WebSocket MQTT (pour le frontend)
MQTT_WS_PORT=9003

# Utilisateur MQTT pour les services internes
MQTT_USER=iad_mqtt_user

# Mot de passe MQTT — CHANGE_ME en production
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD

# ---------------------------------------------------------------------------
## JWT — Authentification
# ---------------------------------------------------------------------------
# Secret JWT — DOIT être une chaîne aléatoire longue (≥ 64 chars)
# Générer avec : openssl rand -hex 64
JWT_SECRET=CHANGE_ME_JWT_SECRET_MUST_BE_AT_LEAST_64_CHARS_LONG_RANDOM_STRING

# Durée de vie du token JWT (format ms: 1h, 7d, 3600s)
JWT_EXPIRES_IN=3600s

# ---------------------------------------------------------------------------
## MinIO — Object Storage (vidéos, modèles, assets)
# ---------------------------------------------------------------------------
# Identifiant root MinIO (équivalent à "access key")
MINIO_ROOT_USER=iad_minio_admin

# Mot de passe root MinIO — CHANGE_ME en production (min 8 chars)
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# Port API MinIO S3-compatible
MINIO_API_PORT=9000

# Port console web MinIO
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
## Grafana — Monitoring & Dashboards
# ---------------------------------------------------------------------------
# Utilisateur administrateur Grafana
GRAFANA_ADMIN_USER=admin

# Mot de passe administrateur Grafana — CHANGE_ME en production
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Port Grafana exposé sur l'hôte
GRAFANA_PORT=3001

# ---------------------------------------------------------------------------
## Prometheus — Métriques
# ---------------------------------------------------------------------------
# Port Prometheus exposé sur l'hôte
PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
## Computer Vision Service (edge-cv)
# ---------------------------------------------------------------------------
# Port du service FastAPI Computer Vision
CV_PORT=8001

# Niveau de log Python : DEBUG | INFO | WARNING | ERROR
CV_LOG_LEVEL=INFO

# Nombre de workers Uvicorn pour le service CV
CV_MAX_WORKERS=2

# ---------------------------------------------------------------------------
## Edge-CV Device Identity (required for MQTT auto-pairing)
# ---------------------------------------------------------------------------
# Identifiant stable de la caméra Edge-CV — utilisé comme clé primaire MQTT.
# DOIT être unique si plusieurs conteneurs edge-cv sont déployés.
EDGE_CV_DEVICE_ID=camera-edge-cv-001

# Identifiant du site auquel la caméra est pré-assignée au démarrage.
# Laisse vide pour laisser la caméra en statut UNPAIRED.
EDGE_CV_SITE_ID=

# Intervalle en secondes entre chaque publication de heartbeat/découverte.
EDGE_CV_HEARTBEAT_INTERVAL=30

# ---------------------------------------------------------------------------
## Edge-CV Gender Classification (T-011)
# ---------------------------------------------------------------------------
GENDER_ENABLED=true
GENDER_MODEL_PATH=models/gender_googlenet.onnx
GENDER_CONFIDENCE_THRESHOLD=0.70

# ---------------------------------------------------------------------------
## SmartQueue ML Service
# ---------------------------------------------------------------------------
# Port du service FastAPI ML
ML_PORT=8002

# Niveau de log Python
ML_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
## Frontend — Variables exposées à Vite (préfixe VITE_ obligatoire)
# ---------------------------------------------------------------------------
# URL de l'API backend accessible depuis le navigateur
VITE_API_URL=http://localhost:3000

# URL WebSocket MQTT accessible depuis le navigateur
# NOTE: 9003 = hôte Docker → 9001 Mosquitto WebSocket (voir docker-compose.yml ports: 9003:9001)
VITE_MQTT_WS_URL=ws://localhost:9003

# Credentials MQTT pour le frontend (doivent correspondre au passwd Mosquitto)
# OBLIGATOIRE : le broker Mosquitto est configuré avec allow_anonymous false
VITE_MQTT_USERNAME=iad_mqtt_user
VITE_MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD

# Désactiver complètement MQTT dans le frontend (true = activé, false = désactivé)
VITE_MQTT_ENABLED=true
