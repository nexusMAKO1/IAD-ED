{
  "uid": "smartqueue",
  "title": "SmartQueue ML Overview",
  "tags": [
    "iad",
    "smartvision"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "title": "Prediction Count",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(smartqueue_prediction_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "title": "Prediction Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(smartqueue_prediction_latency_seconds_bucket[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "title": "Inference Success",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(smartqueue_inference_success_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "title": "Inference Failure",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(smartqueue_inference_failure_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "type": "timeseries",
      "title": "Forecast Requests",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rate(smartqueue_forecast_requests_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "type": "stat",
      "title": "Model Version",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "smartqueue_model_info",
          "refId": "A"
        }
      ]
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  }
}