{
  "uid": "iad-live-overview",
  "title": "IAD Live Overview",
  "tags": [
    "iad",
    "smartvision"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current Visitors",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(iad_current_people)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "value"
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Visitors Today (approx)",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(iad_people_detected_total[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "value"
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Campaign Switches",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(iad_campaign_switches_total[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "value"
          }
        }
      }
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Age Distribution (Last 1h)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(iad_age_child[1h]))",
          "legendFormat": "Child",
          "refId": "A"
        },
        {
          "expr": "sum(increase(iad_age_teen[1h]))",
          "legendFormat": "Teen",
          "refId": "B"
        },
        {
          "expr": "sum(increase(iad_age_young_adult[1h]))",
          "legendFormat": "Young Adult",
          "refId": "C"
        },
        {
          "expr": "sum(increase(iad_age_adult[1h]))",
          "legendFormat": "Adult",
          "refId": "D"
        },
        {
          "expr": "sum(increase(iad_age_senior[1h]))",
          "legendFormat": "Senior",
          "refId": "E"
        }
      ],
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "name",
          "percent"
        ]
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Live Detections (People)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(iad_current_people)",
          "legendFormat": "Total People",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Detection FPS",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "avg(iad_camera_fps)",
          "legendFormat": "FPS",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Processing Latency (ms)",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "avg(iad_processing_latency)",
          "legendFormat": "Latency ms",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "System Status",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "avg(iad_edge_health)",
          "legendFormat": "Edge-CV Health",
          "refId": "A"
        },
        {
          "expr": "avg(iad_backend_health)",
          "legendFormat": "Backend Health",
          "refId": "B"
        },
        {
          "expr": "avg(iad_display_online)",
          "legendFormat": "Display Status",
          "refId": "C"
        },
        {
          "expr": "up{job='mosquitto'}",
          "legendFormat": "MQTT Broker",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red"
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ]
        }
      },
      "options": {
        "textMode": "auto",
        "colorMode": "background"
      }
    }
  ]
}