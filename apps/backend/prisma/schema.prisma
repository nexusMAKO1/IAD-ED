datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum DeviceType {
  DISPLAY            // Display Kiosk
  EDGE_CAMERA        // Edge-CV camera
  TOTEM
  WAITING_ROOM_SCREEN
  TICKET_KIOSK
}

enum DeviceStatus {
  UNPAIRED   // Discovered but not assigned to a site
  ONLINE
  WARNING    // Heartbeat late (30-60 s)
  OFFLINE
  DEGRADED
  UNKNOWN
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
}

enum TicketStatus {
  WAITING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum MLModelType {
  IAD
  SMARTQUEUE
}

// ─── Site ─────────────────────────────────────────────────────────────────────

model Site {
  id                    String          @id @default(uuid()) @db.Uuid
  name                  String
  address               String
  densityThreshold      Int             @default(10)
  anomalyQueueThreshold Int             @default(15)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  devices               Device[]
  tickets               Ticket[]
  audienceEvents        AudienceEvent[]
  users                 User[]

  @@map("sites")
}

// ─── Device (Master Registry) ─────────────────────────────────────────────────

model Device {
  id              String       @id @default(uuid()) @db.Uuid
  deviceId        String       @unique          // persistent hardware identity
  name            String       @default("Device")
  type            DeviceType
  siteId          String?      @db.Uuid         // null = Unassigned
  site            Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  status          DeviceStatus @default(UNPAIRED)

  // Network / identity
  hostname        String?
  ip              String?
  platform        String?
  version         String?
  firmwareVersion String?
  mqttClientId    String?

  // Heartbeat tracking
  lastHeartbeat   DateTime?
  lastSeen        DateTime?
  connectedAt     DateTime?
  disconnectedAt  DateTime?
  mqttConnected   Boolean      @default(false)
  uptime          Int          @default(0)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  // Type-specific metadata (1-to-1)
  cameraMetadata  CameraMetadata?
  displayMetadata DisplayMetadata?

  // Relations
  audienceEvents  AudienceEvent[]

  @@index([siteId])
  @@index([type])
  @@index([status])
  @@map("devices")
}

// ─── CameraMetadata ──────────────────────────────────────────────────────────

model CameraMetadata {
  id                  String   @id @default(uuid()) @db.Uuid
  device              Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId            String   @unique @db.Uuid

  fps                 Int?
  resolution          String?
  streamUrl           String?
  cameraIndex         Int?
  model               String?
  cpuUsage            Float?
  memoryUsage         Float?
  zoneId              String?
  detectionEnabled    Boolean  @default(true)
  ageEstimatorEnabled Boolean  @default(true)
  macAddress          String?

  updatedAt           DateTime @updatedAt

  @@map("camera_metadata")
}

// ─── DisplayMetadata ─────────────────────────────────────────────────────────

model DisplayMetadata {
  id               String   @id @default(uuid()) @db.Uuid
  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId         String   @unique @db.Uuid

  screenResolution String?
  playlist         String?
  activeCampaign   String?
  kioskVersion     String?
  screenId         String?

  updatedAt        DateTime @updatedAt

  @@map("display_metadata")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?
  email     String   @unique
  password  String
  role      UserRole @default(AGENT)
  siteId    String?  @db.Uuid
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@map("users")
}

// ─── Campaign ─────────────────────────────────────────────────────────────────

model Campaign {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  mediaUrl       String
  mediaType      String    @default("video")
  duration       Int       @default(15)
  targetAudience Json
  priority       String    @default("standard")
  status         String    @default("active")
  active         Boolean   @default(true)
  enabled        Boolean   @default(true)
  playlistOrder  Int       @default(0)
  targetAge      String?
  targetGender   String?
  targetEmotion  String?
  startDate      DateTime?
  endDate        DateTime?
  activeHours    Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("campaigns")
}

// ─── AudienceEvent ────────────────────────────────────────────────────────────

model AudienceEvent {
  id           String   @default(uuid()) @db.Uuid
  siteId       String   @db.Uuid
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deviceId     String   @db.Uuid
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  timestamp    DateTime
  peopleCount  Int
  densityScore Float
  avgDwellTime Float
  youngCount   Int
  adultCount   Int
  seniorCount  Int
  maleCount    Int      @default(0)
  femaleCount  Int      @default(0)

  @@id([id, timestamp])
  @@index([siteId])
  @@index([deviceId])
  @@index([timestamp])
  @@map("audience_events")
}

// ─── Ticket ───────────────────────────────────────────────────────────────────

model Ticket {
  id                   String       @id @default(uuid()) @db.Uuid
  siteId               String       @db.Uuid
  site                 Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  ticketNumber         String
  serviceType          String
  status               TicketStatus @default(WAITING)
  createdAt            DateTime     @default(now())
  calledAt             DateTime?
  finishedAt           DateTime?
  estimatedWaitMinutes Int

  @@index([siteId])
  @@index([status])
  @@index([createdAt])
  @@map("tickets")
}

// ─── MLModel ──────────────────────────────────────────────────────────────────

model MLModel {
  id        String      @id @default(uuid()) @db.Uuid
  type      MLModelType
  version   String
  mae       Float
  active    Boolean     @default(true)
  trainedAt DateTime    @default(now())

  @@map("ml_models")
}

// ─── SystemSettings ───────────────────────────────────────────────────────────

model SystemSettings {
  id        String   @id @default("singleton")
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
