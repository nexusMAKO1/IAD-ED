datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum DeviceType {
  DISPLAY            // Display Kiosk
  EDGE_CAMERA        // Edge-CV camera
  TOTEM
  WAITING_ROOM_SCREEN
  TICKET_KIOSK
}

enum DeviceStatus {
  UNPAIRED   // Discovered but not assigned to a site
  ONLINE
  WARNING    // Heartbeat late (30-60 s)
  OFFLINE
  DEGRADED
  UNKNOWN
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
}

enum TicketStatus {
  WAITING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum MLModelType {
  IAD
  SMARTQUEUE
}

// ─── Site ─────────────────────────────────────────────────────────────────────

model Site {
  id                    String          @id @default(uuid()) @db.Uuid
  name                  String
  address               String
  densityThreshold      Int             @default(10)
  anomalyQueueThreshold Int             @default(15)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  devices               Device[]
  tickets               Ticket[]
  audienceEvents        AudienceEvent[]
  users                 User[]

  @@map("sites")
}

// ─── Device (Master Registry) ─────────────────────────────────────────────────

model Device {
  id              String       @id @default(uuid()) @db.Uuid
  deviceId        String       @unique          // persistent hardware identity
  name            String       @default("Device")
  type            DeviceType
  siteId          String?      @db.Uuid         // null = Unassigned
  site            Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  status          DeviceStatus @default(UNPAIRED)

  // Network / identity
  hostname        String?
  ip              String?
  platform        String?
  version         String?
  firmwareVersion String?
  mqttClientId    String?

  // Heartbeat tracking
  lastHeartbeat   DateTime?
  lastSeen        DateTime?
  connectedAt     DateTime?
  disconnectedAt  DateTime?
  mqttConnected   Boolean      @default(false)
  uptime          Int          @default(0)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  // Type-specific metadata (1-to-1)
  cameraMetadata  CameraMetadata?
  displayMetadata DisplayMetadata?

  // Relations
  audienceEvents  AudienceEvent[]

  @@index([siteId])
  @@index([type])
  @@index([status])
  @@map("devices")
}

// ─── CameraMetadata ──────────────────────────────────────────────────────────

model CameraMetadata {
  id                  String   @id @default(uuid()) @db.Uuid
  device              Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId            String   @unique @db.Uuid

  fps                 Int?
  resolution          String?
  streamUrl           String?
  cameraIndex         Int?
  model               String?
  cpuUsage            Float?
  memoryUsage         Float?
  zoneId              String?
  detectionEnabled    Boolean  @default(true)
  ageEstimatorEnabled Boolean  @default(true)
  macAddress          String?

  updatedAt           DateTime @updatedAt

  @@map("camera_metadata")
}

// ─── DisplayMetadata ─────────────────────────────────────────────────────────

model DisplayMetadata {
  id               String   @id @default(uuid()) @db.Uuid
  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId         String   @unique @db.Uuid

  screenResolution String?
  playlist         String?
  activeCampaign   String?
  kioskVersion     String?
  screenId         String?

  updatedAt        DateTime @updatedAt

  @@map("display_metadata")
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?
  email     String   @unique
  password  String
  role      UserRole @default(AGENT)
  siteId    String?  @db.Uuid
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@map("users")
}

// ─── Campaign ─────────────────────────────────────────────────────────────────

model Campaign {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  mediaUrl       String
  mediaType      String    @default("video")
  duration       Int       @default(15)
  targetAudience Json
  priority       String    @default("standard")
  status         String    @default("active")
  active         Boolean   @default(true)
  enabled        Boolean   @default(true)
  playlistOrder  Int       @default(0)
  targetAge      String?
  targetGender   String?
  targetEmotion  String?
  startDate      DateTime?
  endDate        DateTime?
  activeHours    Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  impressions    CampaignImpression[]
  dailyStats     CampaignDailyStatistic[]
  metric         CampaignMetric?
  insights       CampaignInsight[]

  @@map("campaigns")
}

// ─── AudienceEvent ────────────────────────────────────────────────────────────

model AudienceEvent {
  id           String   @default(uuid()) @db.Uuid
  siteId       String   @db.Uuid
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deviceId     String   @db.Uuid
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  timestamp    DateTime
  peopleCount  Int
  densityScore Float
  avgDwellTime Float
  youngCount   Int
  adultCount   Int
  seniorCount  Int
  maleCount    Int      @default(0)
  femaleCount  Int      @default(0)

  @@id([id, timestamp])
  @@index([siteId])
  @@index([deviceId])
  @@index([timestamp])
  @@map("audience_events")
}

// ─── Ticket ───────────────────────────────────────────────────────────────────

model Ticket {
  id                   String       @id @default(uuid()) @db.Uuid
  siteId               String       @db.Uuid
  site                 Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  ticketNumber         String
  serviceType          String
  status               TicketStatus @default(WAITING)
  createdAt            DateTime     @default(now())
  calledAt             DateTime?
  finishedAt           DateTime?
  estimatedWaitMinutes Int

  @@index([siteId])
  @@index([status])
  @@index([createdAt])
  @@map("tickets")
}

// ─── MLModel ──────────────────────────────────────────────────────────────────

model MLModel {
  id        String      @id @default(uuid()) @db.Uuid
  type      MLModelType
  version   String
  mae       Float
  active    Boolean     @default(true)
  trainedAt DateTime    @default(now())

  @@map("ml_models")
}

// ─── SystemSettings ───────────────────────────────────────────────────────────

model SystemSettings {
  id        String   @id @default("singleton")
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ─── Campaign Performance Analytics ──────────────────────────────────────────

enum ImpressionStatus {
  PLAYING
  COMPLETED
  INTERRUPTED
}

enum PerformanceGrade {
  EXCELLENT   // >= 85
  VERY_GOOD   // >= 70
  GOOD        // >= 50
  AVERAGE     // >= 30
  WEAK        // < 30
}

/// One row per campaign play event triggered by the backend decision engine.
model CampaignImpression {
  id                  String            @id @default(uuid()) @db.Uuid
  campaignId          String            @db.Uuid
  campaign            Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// Database ID of the DISPLAY device that played the ad
  displayDeviceId     String            @db.Uuid
  siteId              String            @db.Uuid
  startedAt           DateTime          @default(now())
  endedAt             DateTime?
  plannedDurationSec  Int               @default(15)
  mediaType           String            @default("video")
  priority            String            @default("standard")
  status              ImpressionStatus  @default(PLAYING)

  viewEvents          CampaignViewEvent[]

  @@index([campaignId])
  @@index([siteId])
  @@index([startedAt])
  @@map("campaign_impressions")
}

/// One row per unique ByteTrack ID observed during an impression.
model CampaignViewEvent {
  id           String             @id @default(uuid()) @db.Uuid
  impressionId String             @db.Uuid
  impression   CampaignImpression @relation(fields: [impressionId], references: [id], onDelete: Cascade)
  trackId      Int
  ageGroup     String             @default("unknown")
  firstSeenAt  DateTime
  lastSeenAt   DateTime
  dwellSeconds Float              @default(0)
  siteId       String             @db.Uuid
  /// Hardware deviceId of the Edge-CV camera that saw this person
  cameraDeviceId String

  @@unique([impressionId, trackId])
  @@index([impressionId])
  @@index([siteId])
  @@map("campaign_view_events")
}

/// Aggregated daily KPIs per campaign, computed by the nightly Cron job.
model CampaignDailyStatistic {
  id               String   @id @default(uuid()) @db.Uuid
  campaignId       String   @db.Uuid
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  impressions      Int      @default(0)
  reach            Int      @default(0)
  avgViewTimeSec   Float    @default(0)
  medianViewTimeSec Float   @default(0)
  minViewTimeSec   Float    @default(0)
  maxViewTimeSec   Float    @default(0)
  attentionRate    Float    @default(0)
  completionRate   Float    @default(0)
  avgAudience      Float    @default(0)
  engagementScore  Float    @default(0)
  performanceScore Float    @default(0)
  grade            PerformanceGrade @default(WEAK)
  childCount       Int      @default(0)
  youngAdultCount  Int      @default(0)
  adultCount       Int      @default(0)
  seniorCount      Int      @default(0)
  peakHour         Int?
  avgCrowdDensity  Float    @default(0)

  @@unique([campaignId, date])
  @@index([campaignId])
  @@index([date])
  @@map("campaign_daily_statistics")
}

/// Rolling real-time metric snapshot, updated every 5 min by Cron.
model CampaignMetric {
  id               String           @id @default(uuid()) @db.Uuid
  campaignId       String           @unique @db.Uuid
  campaign         Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  totalImpressions Int              @default(0)
  totalReach       Int              @default(0)
  avgViewTimeSec   Float            @default(0)
  attentionRate    Float            @default(0)
  completionRate   Float            @default(0)
  avgAudience      Float            @default(0)
  engagementScore  Float            @default(0)
  performanceScore Float            @default(0)
  grade            PerformanceGrade @default(WEAK)
  updatedAt        DateTime         @updatedAt

  @@map("campaign_metrics")
}

/// Rule-based AI insight text generated daily for each campaign.
model CampaignInsight {
  id              String           @id @default(uuid()) @db.Uuid
  campaignId      String           @db.Uuid
  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date            DateTime         @db.Date
  text            String
  recommendations Json             @default("[]")
  score           Float            @default(0)
  grade           PerformanceGrade @default(WEAK)
  createdAt       DateTime         @default(now())

  @@unique([campaignId, date])
  @@index([campaignId])
  @@map("campaign_insights")
}

