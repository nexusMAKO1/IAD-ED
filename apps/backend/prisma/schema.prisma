datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
}

enum DeviceType {
  TOTEM
  SCREEN // alias conservé pour compatibilité
  KIOSK // alias conservé pour compatibilité
  CAMERA
  WAITING_ROOM_SCREEN // F4.2 — écran salle d'attente
  TICKET_KIOSK // F4.2 — borne ticket
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  DEGRADED // F4.2 — statut dégradé (partiel)
  WARNING // Alerte — problème non critique détecté
  UNKNOWN // Statut inconnu / pas encore vu
}

enum DisplayStatus {
  UNPAIRED
  ONLINE
  WARNING
  OFFLINE
  ERROR
  UNKNOWN
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
}

enum TicketStatus {
  WAITING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum MLModelType {
  IAD
  SMARTQUEUE
}

model Site {
  id                    String          @id @default(uuid()) @db.Uuid
  name                  String
  address               String
  // F4.3 — Seuils de comportement adaptatif
  densityThreshold      Int             @default(10) // personnes/zone déclenchant l'adaptation
  anomalyQueueThreshold Int             @default(15) // écart en minutes déclenchant l'alerte F2.9
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  devices               Device[]
  tickets               Ticket[]
  audienceEvents        AudienceEvent[]
  users                 User[]
  displayDevices        DisplayDevice[]
  edgeDevices           EdgeDevice[]

  @@map("sites")
}

model Device {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @default("Dispositif") // F4.2 — nom lisible de l'écran avec valeur par défaut pour la migration
  siteId          String          @db.Uuid
  site            Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type            DeviceType
  status          DeviceStatus    @default(UNKNOWN)
  ipAddress       String? // F4.2 — adresse IP optionnelle
  serialNumber    String? // Numéro de série physique
  firmwareVersion String? // Version du firmware
  mqttClientId    String? // Client ID MQTT pour le suivi
  lastSeen        DateTime? // Dernière heartbeat reçue
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  audienceEvents  AudienceEvent[]
  displayDevices  DisplayDevice[]

  @@index([siteId])
  @@index([type])
  @@map("devices")
}

model DisplayDevice {
  id         String        @id @default(uuid()) @db.Uuid
  deviceId   String        @unique
  siteId     String?       @db.Uuid
  site       Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  screenId   String?       @db.Uuid
  screen     Device?       @relation(fields: [screenId], references: [id], onDelete: SetNull)
  hostname   String?
  ip         String?
  platform   String?
  resolution String?
  status     DisplayStatus @default(UNPAIRED)
  version    String?
  uptime     Int           @default(0)
  lastSeen   DateTime?
  lastHeartbeat  DateTime?
  connectedAt    DateTime?
  disconnectedAt DateTime?
  mqttConnected  Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([siteId])
  @@index([status])
  @@map("display_devices")
}

model EdgeDevice {
  id              String        @id @default(uuid()) @db.Uuid
  deviceId        String        @unique
  siteId          String?       @db.Uuid
  site            Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  zoneId          String?       
  hostname        String?
  friendlyName    String?
  ip              String?
  macAddress      String?
  platform        String?
  resolution      String?
  fps             Int?
  status          DisplayStatus @default(UNPAIRED)
  version         String?
  model           String?
  firmwareVersion String?
  uptime          Int           @default(0)
  cpuUsage        Float?
  memoryUsage     Float?
  streamUrl       String?
  mqttConnected   Boolean       @default(false)
  lastSeen        DateTime?
  lastHeartbeat   DateTime?
  connectedAt     DateTime?
  disconnectedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([siteId])
  @@index([status])
  @@map("edge_devices")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String? // Nom complet optionnel
  email     String   @unique
  password  String
  role      UserRole @default(AGENT)
  siteId    String?  @db.Uuid
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@map("users")
}

model Campaign {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  mediaUrl       String
  mediaType      String    @default("video")
  duration       Int       @default(15)
  targetAudience Json
  priority       String    @default("standard")
  status         String    @default("active")
  active         Boolean   @default(true)
  enabled        Boolean   @default(true)
  playlistOrder  Int       @default(0)
  targetAge      String?
  targetGender   String?
  targetEmotion  String?
  startDate      DateTime?
  endDate        DateTime?
  activeHours    Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("campaigns")
}

model AudienceEvent {
  id           String   @default(uuid()) @db.Uuid
  siteId       String   @db.Uuid
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  deviceId     String   @db.Uuid
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  timestamp    DateTime
  peopleCount  Int
  densityScore Float
  avgDwellTime Float
  youngCount   Int
  adultCount   Int
  seniorCount  Int

  // Composite primary key including timestamp is required for TimescaleDB hypertables
  @@id([id, timestamp])
  @@index([siteId])
  @@index([deviceId])
  @@index([timestamp])
  @@map("audience_events")
}

model Ticket {
  id                   String       @id @default(uuid()) @db.Uuid
  siteId               String       @db.Uuid
  site                 Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  ticketNumber         String
  serviceType          String
  status               TicketStatus @default(WAITING)
  createdAt            DateTime     @default(now())
  calledAt             DateTime?
  finishedAt           DateTime?
  estimatedWaitMinutes Int

  @@index([siteId])
  @@index([status])
  @@index([createdAt])
  @@map("tickets")
}

model MLModel {
  id        String      @id @default(uuid()) @db.Uuid
  type      MLModelType
  version   String
  mae       Float
  active    Boolean     @default(true)
  trainedAt DateTime    @default(now())

  @@map("ml_models")
}

/// Singleton table storing all application settings as a JSON blob.
/// Only one row with id = 'singleton' should ever exist.
model SystemSettings {
  id        String   @id @default("singleton")
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
